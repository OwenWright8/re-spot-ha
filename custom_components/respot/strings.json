{
  "config": {
    "step": {
      "user": {
        "title": "re-spot",
        "description": "Adds re-spot. Every Echo Spot running re-spot that's connected to this Home Assistant then shows up here as its own device, with its face, screen, brightness, alarm, auto-rotate and sleep sound settings, button and alarm events, and a notify entity for sending messages to its screen."
      }
    },
    "abort": {
      "single_instance_allowed": "re-spot is already set up. New Spots are added automatically."
    }
  },
  "entity": {
    "select": {
      "face": { "name": "Face" },
      "sound": { "name": "Sleep sound" }
    },
    "switch": {
      "screen": { "name": "Screen" },
      "alarm": { "name": "Alarm" },
      "rotate": { "name": "Auto-rotate" }
    },
    "number": {
      "brightness": { "name": "Brightness" },
      "sleep_timer": { "name": "Sleep timer" }
    },
    "time": {
      "alarm_time": { "name": "Alarm time" }
    },
    "binary_sensor": {
      "connected": { "name": "Connected" }
    },
    "sensor": {
      "last_message": { "name": "Last message" }
    },
    "notify": {
      "message": { "name": "Message" }
    },
    "event": {
      "button": {
        "name": "Top button",
        "state_attributes": {
          "event_type": {
            "state": {
              "single": "Pressed",
              "double": "Double pressed",
              "hold": "Held"
            }
          }
        }
      },
      "alarm_event": {
        "name": "Alarm",
        "state_attributes": {
          "event_type": {
            "state": {
              "sunrise": "Sunrise started",
              "ringing": "Ringing",
              "dismissed": "Dismissed",
              "timeout": "Stopped (no response)",
              "cancelled": "Cancelled"
            }
          }
        }
      }
    }
  },
  "services": {
    "report": {
      "name": "Report",
      "description": "Used by re-spot Spots to register and check in. You don't need to call this yourself.",
      "fields": {
        "spot_id": { "name": "Spot ID", "description": "The Spot's re-spot device ID." },
        "name": { "name": "Name", "description": "The Spot's name." },
        "faces": { "name": "Faces", "description": "Faces available on the Spot." },
        "version": { "name": "Version", "description": "Player version." },
        "init": { "name": "Initial settings", "description": "Settings to start with when a Spot first registers." },
        "message": { "name": "Message", "description": "The latest message the Spot received." },
        "event": { "name": "Event", "description": "A button or alarm event." }
      }
    }
  }
}
